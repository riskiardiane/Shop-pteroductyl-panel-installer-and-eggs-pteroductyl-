# ==== Billing / MustikaPay ====
APP_URL=https://panel.exions.web.id

MUSTIKA_BASE_URL=https://mustikapayment.com
MUSTIKA_API_KEY=
MUSTIKA_TIMESTAMP_TOLERANCE=0

BILLING_SUCCESS_URL=https://panel.exions.web.id/success
BILLING_CANCEL_URL=https://panel.exions.web.id/pricing
BILLING_EXPIRY_MINUTES=30
BILLING_INVOICE_PREFIX=INV
BILLING_GRACE_DAYS=7

# ==== Pterodactyl Application API ====
# Buat di /admin/api, permission: users.read, users.write, servers.read, servers.write, nodes.read
PTERODACTYL_APP_URL=https://panel.exions.web.id
PTERODACTYL_APP_API_KEY=

# ==== Target provisioning paket (opsional, dipakai seeder) ====
BILLING_PLAN_NEST_ID=1
BILLING_PLAN_EGG_ID=1
BILLING_PLAN_NODE_ID=1
BILLING_PLAN_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:java_17
BILLING_PLAN_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}
BILLING_PLAN_ENVIRONMENT='{"SERVER_JARFILE":"server.jar","VANILLA_VERSION":"latest"}'
